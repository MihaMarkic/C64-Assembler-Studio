{
    "app-id": "com.rthand.C64AssemblerStudio",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "C64AssemblerStudio",
    "finish-args": [
        "--device=dri", 
        "--socket=x11", 
        "--socket=wayland", 
        "--share=ipc",
        "--filesystem=home",
        "--filesystem=host",
        "--share=network"],
    "modules": [
        {
            "name": "C64AssemblerStudio",
            "buildsystem": "simple",
            "build-commands": [
                "cp -r . /app/bin"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../../../src/C64AssemblerStudio/publish/linux_x64"
                }
            ]
        }
    ]
}
